# TaxPilot Test Environment Configuration
NODE_ENV=test
PORT=5002
DATABASE_URL=postgresql://postgres:1245@localhost:5432/taxpilot_test_db
JWT_ACCESS_SECRET=test_jwt_access_secret_key_minimum_32_characters
JWT_REFRESH_SECRET=test_jwt_refresh_secret_key_minimum_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# OCR & AI Providers (Mocked for deterministic testing)
OCR_PROVIDER=mock
OCR_API_KEY=mock-key
LLM_PROVIDER=mock
LLM_API_KEY=mock-llm-key
LLM_MODEL=gemini-1.5-pro
RAG_VECTOR_STORE=memory

# Storage Configuration
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_PATH=./test-storage
MAX_DOCUMENT_SIZE_MB=15

# Integration Providers
PAN_PROVIDER=mock
SETU_BASE_URL=https://dg-sandbox.setu.co
SETU_CLIENT_ID=mock_setu_client_id
SETU_CLIENT_SECRET=mock_setu_client_secret
SETU_PRODUCT_INSTANCE_ID=mock_instance_id
SANDBOX_API_KEY=mock_sandbox_key
SANDBOX_API_SECRET=mock_sandbox_secret
SANDBOX_BASE_URL=https://test-api.sandbox.co.in

# Clerk Auth Mocks for Testing
CLERK_PUBLISHABLE_KEY=pk_test_mock_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_mock_clerk_secret_key
