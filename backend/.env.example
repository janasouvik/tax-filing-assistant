NODE_ENV=development
PORT=5001
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/taxpilot_db
JWT_ACCESS_SECRET=change_this_in_production
JWT_REFRESH_SECRET=change_this_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=taxpilot-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
REDIS_URL=redis://localhost:6379
OCR_PROVIDER=mock
OCR_API_KEY=
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o
RAG_VECTOR_STORE=memory
CLERK_PUBLISHABLE_KEY=your_cleck_publishable_key
CLERK_SECRET_KEY=your_cleck_secret_key

# PAN Verification (server-side only)
# Use "mock" for development, "setu" for sandbox/production
PAN_PROVIDER=setu
SETU_BASE_URL=https://dg-sandbox.setu.co
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=